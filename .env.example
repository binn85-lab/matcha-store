# ---------------------------------------------------------------------------
# Homelab matcha store — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase — database + auth
# Dashboard: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=            # e.g. https://xxxx.supabase.co (public, safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon/public key, used by browser client
SUPABASE_SERVICE_ROLE_KEY=           # service-role key — server only, NEVER expose to client

# Midtrans — Indonesian payment gateway (GoPay, QRIS, bank transfer, CC)
# Dashboard: https://dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=                 # server key, server only
MIDTRANS_CLIENT_KEY=                 # client key, server side reference
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=     # client key exposed to browser for Snap.js
MIDTRANS_IS_PRODUCTION=false         # "true" for production, "false" for sandbox

# Cloudinary — product image hosting + transformations
# Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=               # cloud name
CLOUDINARY_API_KEY=                  # API key, server only
CLOUDINARY_API_SECRET=               # API secret, server only
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=   # cloud name exposed to browser for <CldImage />

# Resend — transactional email (order confirmations, shipping)
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=                      # Resend API key, server only
RESEND_FROM_EMAIL=hello@homelab.id   # verified sender address

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # canonical site URL (for OG tags, emails)
